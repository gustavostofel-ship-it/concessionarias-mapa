# SUPABASE_URL: URL do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"

# SUPABASE_ANON_KEY: Chave anônima (pública) do Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# MAPBOX_TOKEN: Token público (pk.) da sua própria conta Mapbox.
# Crie em https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# MAPBOX_STYLE: opcional. Estilo customizado do Mapbox Studio.
# Se não definido, usa o estilo padrão "mapbox://styles/mapbox/streets-v12".
NEXT_PUBLIC_MAPBOX_STYLE=
